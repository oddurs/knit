---
import '../styles/global.css';
const { title, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
const inDocs = here.startsWith(base + 'docs');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle ? `${pageTitle} · knit` : 'knit — share hardware with the machines around you'}</title>
    <meta name="description" content="Share compute across your machines with zero config." />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="frame">
      <header class="top">
        <a class="wordmark" href={base}>knit</a>
        <nav>
          <a href={`${base}docs/`} aria-current={inDocs ? 'page' : undefined}>Docs</a>
          <a href="https://github.com/oddurs/knit/releases">Releases</a>
          <a href="https://github.com/oddurs/knit">GitHub</a>
        </nav>
      </header>
      {inDocs ? <slot /> : <main><slot /></main>}
      <footer class="bottom">
        knit is a single static Go binary. One dependency, seven commands, a protocol that fits on a page.
        Curious how it is built? The <a href="https://github.com/oddurs/knit/tree/main/docs">engineering docs</a> are in the repository.
      </footer>
    </div>
  </body>
</html>
