---
import '../styles/global.css';
const { title, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
const inDocs = here.startsWith(base + 'docs');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle ? `${pageTitle} · knit` : 'knit — share hardware with the machines around you'}</title>
    <meta name="description" content="Share compute across your machines with zero config." />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="frame">
      <header class="top">
        <a class="wordmark" href={base}>knit</a>
        <nav>
          <a href={`${base}docs/`} aria-current={inDocs ? 'page' : undefined}>Docs</a>
          <a href="https://github.com/oddurs/knit/releases">Releases</a>
          <a href="https://github.com/oddurs/knit">GitHub</a>
        </nav>
      </header>
      {inDocs ? <slot /> : <main><slot /></main>}
    </div>
    <script is:inline>
      // Copy buttons on code blocks that declare a language (```sh, ```json).
      // Transcripts and plain blocks are left alone.
      for (const code of document.querySelectorAll('pre[data-language]:not([data-language="plaintext"]) > code')) {
        const b = document.createElement('button');
        b.className = 'copy';
        b.type = 'button';
        b.textContent = 'Copy';
        b.setAttribute('aria-label', 'Copy code');
        b.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(code.textContent); } catch { return; }
          b.textContent = 'Copied';
          b.dataset.done = '';
          setTimeout(() => { b.textContent = 'Copy'; delete b.dataset.done; }, 1500);
        });
        code.parentElement.appendChild(b);
      }
    </script>
  </body>
</html>
