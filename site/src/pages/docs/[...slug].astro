---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { docsNav } from '../../lib/nav.mjs';
import { slugFor, titleOf } from '../../lib/slug.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    // 'docs/vision/' -> 'vision'; 'docs/' -> undefined (the index route)
    params: { slug: slugFor(entry.id + '.md').replace(/^docs\//, '').replace(/\/$/, '') || undefined },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = titleOf(entry.body ?? '', entry.id);
const nav = await docsNav();
const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
const current = (p) => (here === base + p ? 'page' : undefined);
---
<Base title={title}>
  <div class="docs">
    <aside>
      <ul>
        <li><a href={`${base}docs/`} aria-current={current('docs/')}>Overview</a></li>
      </ul>
      <h4>Guides</h4>
      <ul>{nav.guides.map((i) => <li><a href={base + i.path} aria-current={current(i.path)}>{i.title}</a></li>)}</ul>
      <h4>Decisions</h4>
      <ul>
        <li><a href={`${base}docs/adr/`} aria-current={current('docs/adr/')}>About ADRs</a></li>
        {nav.adrs.map((i) => <li><a href={base + i.path} aria-current={current(i.path)}>{i.title}</a></li>)}
      </ul>
    </aside>
    <article class="prose">
      <Content />
      <p><small><a href={`https://github.com/oddurs/knit/blob/main/docs/${entry.id}.md`}>Edit this page on GitHub</a></small></p>
    </article>
  </div>
</Base>
